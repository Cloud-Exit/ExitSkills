# Copy to .env.docker and provide real values. Never commit .env.docker.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ENCRYPTION_KEY=
MASTER_TOKEN=

# Leave both blank to disable LLM assessment.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

POSTGRES_PASSWORD=exitskills-local
EXITSKILLS_PORT=8111
PUBLIC_BASE_URL=http://localhost:8111
INDEX_INTERVAL=168h
INDEX_ON_START=true
INDEX_CONCURRENCY=2
AI_AUDIT_INTERVAL=5s
LOG_LEVEL=info
