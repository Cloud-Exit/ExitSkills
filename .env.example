# make run/admin always use sqlite://.local/skills.db by default.
# Production binaries use DATABASE_URL, for example:
# DATABASE_URL=postgres://skills:change-me@localhost:5432/skills?sslmode=disable
# Prefer OAuth App client credentials. They take precedence if a legacy
# GITHUB_TOKEN is also inherited from the shell or still present in a Secret.
# OAuth App client
# credentials receive the per-app public-data quota (15,000/hour for an
# Enterprise Cloud-owned app). GITHUB_TOKEN remains the legacy fallback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
# Local passphrase; make run/admin derive a 32-byte development key from it.
# Production must use a base64-encoded 32-byte key instead.
ENCRYPTION_KEY=test
# Master bearer credential for /v1/admin/*; use a random secret in production.
MASTER_TOKEN=replace-with-random-secret
# Leave AI_BASE_URL and AI_MODEL empty together to disable LLM assessment.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini
PUBLIC_BASE_URL=https://skills.exitmesh.com
INDEX_INTERVAL=168h
INDEX_ON_START=true
INDEX_CONCURRENCY=2
AI_AUDIT_INTERVAL=5s
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW=1m
LISTEN_ADDRESS=:8080
LOG_LEVEL=info
